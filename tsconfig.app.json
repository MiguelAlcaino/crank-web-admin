{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "tests"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // @vuelidate/core ships types but does not list them in its package.json "exports", which
      // `moduleResolution: bundler` respects. Point TypeScript at them directly.
      "@vuelidate/core": ["./node_modules/@vuelidate/core/index.d.ts"]
    }
  }
}
